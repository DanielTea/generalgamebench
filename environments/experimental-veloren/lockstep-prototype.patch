--- /dev/null
+++ b/voxygen/src/benchmark.rs
@@ -0,0 +1,41 @@
+use std::sync::{Condvar, Mutex, atomic::{AtomicBool, AtomicUsize, Ordering}};
+use crate::{game_input::GameInput, window::Event};
+static GATE: Mutex<(bool, u64, u64)> = Mutex::new((false, 0, 0));
+static WAKE: Condvar = Condvar::new();
+pub static FRAMES: AtomicUsize = AtomicUsize::new(0);
+pub static ACTION: AtomicUsize = AtomicUsize::new(0);
+pub static COLLECTED: AtomicUsize = AtomicUsize::new(0);
+pub static DEAD: AtomicBool = AtomicBool::new(false);
+pub fn enabled() -> bool { std::env::var_os("GGBENCH_CAPTURE").is_some() }
+pub fn server_wait() {
+    if !enabled() { return; }
+    let mut gate = GATE.lock().unwrap();
+    gate.0 = true;
+    WAKE.notify_all();
+    while gate.1 == gate.2 { gate = WAKE.wait(gate).unwrap(); }
+}
+pub fn server_done() {
+    if !enabled() { return; }
+    let mut gate = GATE.lock().unwrap();
+    gate.2 = gate.1;
+    WAKE.notify_all();
+}
+pub fn advance_server() {
+    if !enabled() { return; }
+    let mut gate = GATE.lock().unwrap();
+    if !gate.0 { return; }
+    gate.1 += 1;
+    WAKE.notify_all();
+    while gate.2 < gate.1 { gate = WAKE.wait(gate).unwrap(); }
+}
+pub fn inputs(events: &mut Vec<Event>) {
+    let action = ACTION.load(Ordering::SeqCst);
+    for (id, input) in [(1, GameInput::MoveForward), (2, GameInput::MoveRight),
+        (3, GameInput::MoveBack), (4, GameInput::MoveLeft), (5, GameInput::Jump),
+        (6, GameInput::Interact)] {
+        events.push(Event::InputUpdate(input, action == id));
+    }
+    if action == 7 || action == 8 {
+        events.push(Event::CursorPan(vek::Vec2::new(if action == 7 { -8.0 } else { 8.0 }, 0.0)));
+    }
+}
