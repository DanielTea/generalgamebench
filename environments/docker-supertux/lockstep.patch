diff --git a/src/supertux/screen_manager.cpp b/src/supertux/screen_manager.cpp
index 5cd1a08..f1d2d06 100644
--- a/src/supertux/screen_manager.cpp
+++ b/src/supertux/screen_manager.cpp
@@ -43,6 +43,8 @@
 #include "video/compositor.hpp"
 #include "video/drawing_context.hpp"
 
+#include "control/codecontroller.hpp"
+#include <cstdlib>
 #include <stdio.h>
 #include <chrono>
 #include <iostream>
@@ -623,6 +625,41 @@ ScreenManager::run()
   Integration::init_all();
 
   handle_screen_switch();
+  if (std::getenv("GGBENCH_CAPTURE")) {
+    auto session = GameSession::current();
+    if (!session) throw std::runtime_error("Benchmark requires a level");
+    CodeController controls;
+    auto& player = session->get_current_sector().get_player();
+    player.set_controller(&controls);
+    bool ended = false;
+    auto emit = [&]() {
+      Compositor compositor(m_video_system);
+      draw(compositor, *m_fps_statistics);
+      const int coins = session->get_current_level().m_stats.get_coins();
+      ended = coins >= 1 || player.is_dying() || player.is_dead();
+      std::cout << "GGBENCH {\"coins\":" << coins
+                << ",\"done\":" << (ended ? "true" : "false") << "}" << std::endl;
+    };
+    emit();
+    int action;
+    while (!ended && (std::cin >> action)) {
+      if (action < 0 || action > 8) throw std::runtime_error("Invalid benchmark control");
+      for (int tick = 0; tick < 8; ++tick) {
+        controls.update();
+        controls.press(Control::LEFT, action == 1 || action == 4);
+        controls.press(Control::RIGHT, action == 2 || action == 5 || action == 6 || action == 7);
+        controls.press(Control::JUMP, action == 3 || action == 4 || action == 5 || action == 7);
+        controls.press(Control::ACTION, action == 6 || action == 7);
+        controls.press(Control::DOWN, action == 8);
+        g_game_time += seconds_per_step;
+        g_real_time = g_game_time;
+        update_gamelogic(seconds_per_step);
+        if (session->get_current_level().m_stats.get_coins() >= 1 || player.is_dying() || player.is_dead()) break;
+      }
+      emit();
+    }
+    return;
+  }
 #ifdef __EMSCRIPTEN__
   emscripten_set_main_loop(g_loop_iter, -1, 1);
 #else
