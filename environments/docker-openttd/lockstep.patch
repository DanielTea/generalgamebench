+            else if (action == 6) { _left_button_down = false; _left_button_clicked = false; }
+            else if (action == 7) { HandleKeypress(WKC_SHIFT | WKC_F8, 0); }
+            else if (action == 8) { HandleKeypress('3', '3'); }
+            else if (action == 9) { HandleKeypress(WKC_ESC, 0); }
+            ::InputLoop(); ::GameLoop(); ::UpdateWindows();
+        }
+        return;
+    }
