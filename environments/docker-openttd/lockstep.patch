+            int action;
+            if (!(std::cin >> action)) return;
+            if (action >= 1 && action <= 4) {
+                const int dx[] = {0, 0, 32, 0, -32};
+                const int dy[] = {0, -32, 0, 32, 0};
+                _cursor.UpdateCursorPosition(std::clamp(_cursor.pos.x + dx[action], 0, _screen.width - 1),
+                    std::clamp(_cursor.pos.y + dy[action], 0, _screen.height - 1));
