@@ -1061,6 +1085,19 @@ void SDLWrapper::remove_timer(unsigned int& timer_id)
 
 void SDLWrapper::swap_buffers()
 {
+    if (const char* path = std::getenv("GGBENCH_CAPTURE")) {
+        int width, height;
+        SDL_GL_GetDrawableSize(m_window, &width, &height);
+        std::vector<unsigned char> pixels(width * height * 3);
+        glPixelStorei(GL_PACK_ALIGNMENT, 1);
+        glReadPixels(0, 0, width, height, GL_RGB, GL_UNSIGNED_BYTE, pixels.data());
+        std::ofstream out(path, std::ios::binary | std::ios::trunc);
+        out << "P6\n" << width << " " << height << "\n255\n";
+        for (int row=height-1; row>=0; --row)
+            out.write(reinterpret_cast<const char*>(pixels.data()+row*width*3), width*3);
+        if (!out) throw std::runtime_error("Benchmark camera capture failed");
+    }
+
     SDL_GL_SwapWindow(m_window);
 }
 
